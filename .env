# Local development environment. Committed: it documents every variable the app reads locally.
# Every value here is plain local config, declared on the config line below; a secret never
# appears here as a value.
#
# To add a secret: create the 1Password item candy-vote.local in the vault app-secrets, with
# one field named after the variable, then add its reference here:
#   KEY=op://app-secrets/candy-vote.local/KEY
# From then on, run the dev server under op run:
#   op run --env-file=.env -- npm run dev
# Without op run, the dev and build scripts stop at startup and name the unresolved variable
# (scripts/load-env.mjs). A raw value for a key that is not on the config line below fails the
# check gate (npm run check:env).
# config: PORT GCP_PROJECT FIRESTORE_DATABASE FIRESTORE_EMULATOR_HOST OWNER_KEY
#
# Production never reads this file: Cloud Run injects PORT and holds the rest of the service's
# configuration.
#
# Variable expansion is supported, e.g.:
#   HOST=localhost
#   BASE_URL=http://${HOST}:${PORT}

# Port the server listens on (and the dev proxy targets).
PORT=8080

# Where ballots are kept: Firestore. Locally, the emulator that npm run dev starts at
# FIRESTORE_EMULATOR_HOST (its data lasts until dev stops). The demo- prefix marks a project id
# that exists only in the emulator. In the cloud, Cloud Run sets the real project and database
# and no emulator setting at all.
GCP_PROJECT=demo-candy-vote
FIRESTORE_DATABASE=candy-vote-local
FIRESTORE_EMULATOR_HOST=127.0.0.1:8186

# The owner device's key, for local development only: it unlocks the local emulator and nothing
# else, so it is plain config here. Open http://localhost:5173/#owner=<this value> once to make a
# browser the owner device. Production refuses any key starting with "local-"; its key lives in
# Secret Manager.
OWNER_KEY=local-owner-key-for-the-emulator-only
